model Warehouse {
  issues WarehouseIssue[]
  issueSheets WarehouseIssueSheet[]
  receipts WarehouseReceipt[]
  id               BigInt                     @id @default(autoincrement())
  name             String                     @unique(map: "uq_warehouses_name") @db.VarChar(255)
  isActive         Boolean                    @default(true) @map("is_active")
  externalLinks WarehouseExternalWarehouse[]
  storageLocations WarehouseStorageLocation[]

  @@map("warehouses")
}

model WarehouseItem {
  reservations WarehouseReservation[]
  transfers WarehouseTransfer[]
  externalLinks WarehouseItemExternalLink[]
  receiptLines WarehouseReceiptLine[]
  id              BigInt                    @id @default(autoincrement())
  article         String                    @unique(map: "uq_warehouse_items_article") @db.VarChar(100)
  name            String                    @db.VarChar(255)
  unit            String                    @db.VarChar(50)
  comment         String?                   @db.Text
  isActive        Boolean                   @default(true) @map("is_active")
  balances        WarehouseBalance[]
  issueSheetLines WarehouseIssueSheetLine[]

  @@index([article(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_warehouse_items_article_trgm")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_warehouse_items_name_trgm")
  @@map("warehouse_items")
}

model WarehouseStorageLocation {
  reservationAllocations WarehouseReservationAllocation[]
  transfersFrom WarehouseTransfer[] @relation("WarehouseTransferFrom")
  transfersTo WarehouseTransfer[] @relation("WarehouseTransferTo")
  receiptPlacements WarehouseReceiptPlacement[]
  warehouseId     BigInt                    @map("warehouse_id")
  warehouse       Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_storage_locations_warehouse")
  id              BigInt                    @id @default(autoincrement())
  name            String                    @db.VarChar(255)
  isActive        Boolean                   @default(true) @map("is_active")
  balances        WarehouseBalance[]
  issueSheetLines WarehouseIssueSheetLine[]

  @@unique([warehouseId, name], map: "uq_warehouse_storage_locations_warehouse_name")
  @@map("warehouse_storage_locations")
}


model WarehouseBalance {
  id                BigInt                        @id @default(autoincrement())
  itemId            BigInt                        @map("item_id")
  storageLocationId BigInt                        @map("storage_location_id")
  // DB-only chk_warehouse_balances_quantity: quantity >= 0.
  quantity          Decimal                       @default(0) @db.Decimal(14, 3)
  adjustments       WarehouseStockAdjustment[]
  issuePositions    WarehouseIssuePosition[]
  item              WarehouseItem                 @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_balances_item")
  storageLocation   WarehouseStorageLocation      @relation(fields: [storageLocationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_balances_storage_location")

  @@unique([itemId, storageLocationId], map: "uq_warehouse_balances_item_location")
  @@index([storageLocationId], map: "idx_warehouse_balances_storage_location")
  @@map("warehouse_balances")
}


model WarehouseIssueSheet {
  warehouseId BigInt @map("warehouse_id")
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  id                BigInt                    @id @default(autoincrement())
  name              String                    @db.VarChar(255)
  sourceFileName    String?                   @map("source_file_name") @db.VarChar(255)
  sourceFileHash    String?                   @map("source_file_hash") @db.VarChar(64)
  status            String                    @db.VarChar(50)
  createdByUserId   String                    @map("created_by_user_id")
  processedByUserId String?                   @map("processed_by_user_id")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt       DateTime?                 @map("processed_at") @db.Timestamptz(6)
  lines             WarehouseIssueSheetLine[]
  createdBy         User                      @relation("WarehouseIssueSheetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issue_sheets_created_by")
  processedBy       User?                     @relation("WarehouseIssueSheetProcessedBy", fields: [processedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issue_sheets_processed_by")

  @@index([warehouseId], map: "idx_warehouse_issue_sheets_warehouse")
  @@map("warehouse_issue_sheets")
}

model WarehouseIssueSheetLine {
  id                BigInt                    @id @default(autoincrement())
  issueSheetId      BigInt                    @map("issue_sheet_id")
  itemId            BigInt?                   @map("item_id")
  storageLocationId BigInt?                   @map("storage_location_id")
  // DB-only chk_warehouse_issue_sheet_lines_quantity: quantity > 0.
  quantity          Decimal                   @db.Decimal(14, 3)
  unitSnapshot      String?                   @map("unit_snapshot") @db.VarChar(50)
  sourceArticle     String?                   @map("source_article") @db.VarChar(100)
  sourceName        String?                   @map("source_name") @db.VarChar(255)
  sourceLocation    String?                   @map("source_location") @db.VarChar(255)
  matchingStatus    String                    @map("matching_status") @db.VarChar(50)
  error             String?                   @db.Text
  // DB-only chk_warehouse_issue_sheet_lines_row_number: row_number > 0.
  rowNumber         Int                       @map("row_number")
  issues            WarehouseIssue[]
  issueSheet        WarehouseIssueSheet       @relation(fields: [issueSheetId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issue_sheet_lines_sheet")
  item              WarehouseItem?            @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issue_sheet_lines_item")
  storageLocation   WarehouseStorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issue_sheet_lines_storage_location")

  @@unique([issueSheetId, rowNumber], map: "uq_warehouse_issue_sheet_lines_sheet_row")
  @@map("warehouse_issue_sheet_lines")
}

model WarehouseIssue {
  snapshot Json @db.JsonB
  searchText String @map("search_text") @db.Text
  warehouseId BigInt @map("warehouse_id")
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  request WarehouseIssueRequest?
  id                   BigInt                   @id @default(autoincrement())
  // DB-only chk_warehouse_issues_type_line: MANUAL has no line; ISSUE_SHEET requires a line.
  type                 String                   @db.VarChar(50)
  issueSheetLineId     BigInt?                  @map("issue_sheet_line_id")
  issuedByUserId       String                   @map("issued_by_user_id")
  comment              String?                  @db.Text
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  issueSheetLine       WarehouseIssueSheetLine? @relation(fields: [issueSheetLineId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issues_sheet_line")
  issuedBy             User                     @relation("WarehouseIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issues_issued_by")
  positions            WarehouseIssuePosition[]

  @@index([issueSheetLineId], map: "idx_warehouse_issues_sheet_line")
  @@index([issuedByUserId], map: "idx_warehouse_issues_issued_by")
  @@index([createdAt], map: "idx_warehouse_issues_created_at")
  @@index([warehouseId], map: "idx_warehouse_issues_warehouse")
  @@index([warehouseId, createdAt, id], map: "idx_warehouse_issues_warehouse_created")
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_warehouse_issues_history_search")
  @@map("warehouse_issues")
}

model WarehouseIssuePosition {
  snapshot Json @db.JsonB
  id        BigInt           @id @default(autoincrement())
  issueId   BigInt           @map("issue_id")
  balanceId BigInt           @map("balance_id")
  // DB-only chk_warehouse_issue_positions_quantity: quantity > 0.
  quantity  Decimal          @db.Decimal(14, 3)
  issue     WarehouseIssue   @relation(fields: [issueId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issue_positions_issue")
  balance   WarehouseBalance @relation(fields: [balanceId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_warehouse_issue_positions_balance")

  @@unique([issueId, balanceId], map: "uq_warehouse_issue_positions_issue_balance")
  @@index([balanceId], map: "idx_warehouse_issue_positions_balance")
  @@map("warehouse_issue_positions")
}

enum WarehouseAdjustmentType {
  WRITE_OFF
  SURPLUS

  @@map("warehouse_adjustment_type")
}

model WarehouseStockAdjustment {
  id              BigInt                               @id @default(autoincrement())
  balanceId       BigInt                               @map("balance_id")
  balance         WarehouseBalance                     @relation(fields: [balanceId], references: [id], onDelete: Restrict, map: "fk_warehouse_stock_adjustments_balance")
  type            WarehouseAdjustmentType
  quantity        Decimal                              @db.Decimal(14, 3)
  quantityBefore  Decimal                              @map("quantity_before") @db.Decimal(14, 3)
  quantityAfter   Decimal                              @map("quantity_after") @db.Decimal(14, 3)
  reason          String                               @db.VarChar(1000)
  comment         String?                              @db.Text
  requestKey      String                               @map("request_key") @db.Uuid
  requestHash     String                               @map("request_hash") @db.VarChar(64)
  createdByUserId String                               @map("created_by_user_id")
  createdBy       User                                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_warehouse_stock_adjustments_user")
  createdAt       DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedReceiptId BigInt? @map("resolved_receipt_id")
  resolvedReceipt WarehouseReceipt? @relation(fields:[resolvedReceiptId],references:[id],onDelete:Restrict)
  attachments     WarehouseStockAdjustmentAttachment[]

  @@unique([createdByUserId, requestKey], map: "uq_warehouse_stock_adjustments_request")
  @@index([balanceId, createdAt], map: "idx_warehouse_stock_adjustments_balance")
  @@index([resolvedReceiptId],map:"idx_warehouse_adjustments_resolved_receipt")
  @@map("warehouse_stock_adjustments")
}

model WarehouseStockAdjustmentAttachment {
  adjustmentId BigInt                   @map("adjustment_id")
  fileId       Int                      @unique(map: "uq_warehouse_stock_adjustment_attachments_file") @map("file_id")
  adjustment   WarehouseStockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict, map: "fk_warehouse_stock_adjustment_attachments_adjustment")
  file         StorageFile              @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "fk_warehouse_stock_adjustment_attachments_file")

  @@id([adjustmentId, fileId], map: "pk_warehouse_stock_adjustment_attachments")
  @@map("warehouse_stock_adjustment_attachments")
}

model WarehouseReceipt {
 id BigInt @id @default(autoincrement())
 warehouseId BigInt? @map("warehouse_id")
 warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
 source String @db.VarChar(20)
 sourceSystem String @map("source_system") @db.VarChar(100)
 sourceOperationId String @map("source_operation_id") @db.VarChar(255)
 requestHash String @map("request_hash") @db.VarChar(64)
 sourceVersion BigInt? @map("source_version")
 sourcePayload Json? @map("source_payload") @db.JsonB
 pendingPayload Json? @map("pending_payload") @db.JsonB
 conflict String? @db.VarChar(100)
 status String @default("RECEIVED") @db.VarChar(20)
 documentNumber String? @map("document_number") @db.VarChar(100)
 documentDate DateTime? @map("document_date") @db.Date
 comment String? @db.VarChar(4000)
 externalWarehouseId String? @map("external_warehouse_id") @db.VarChar(255)
 warehouseNameSnapshot String @map("warehouse_name_snapshot") @db.VarChar(255)
 createdByUserId String @map("created_by_user_id")
 createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
 placedAt DateTime? @map("placed_at") @db.Timestamptz(6)
 lines WarehouseReceiptLine[]
 settlementAdjustments WarehouseStockAdjustment[]
 @@unique([source, sourceSystem, sourceOperationId], map: "uq_warehouse_receipts_source_operation")
 @@index([warehouseId, status, createdAt], map: "idx_warehouse_receipts_work")
 @@index([status, createdAt, id], map: "idx_warehouse_receipts_status")
 @@index([createdAt, id], map: "idx_warehouse_receipts_created")
 @@map("warehouse_receipts")
}
model WarehouseReceiptLine {
 id BigInt @id @default(autoincrement())
 receiptId BigInt @map("receipt_id")
 receipt WarehouseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
 rowNumber Int @map("row_number")
 externalLineId String @map("external_line_id") @db.VarChar(255)
 itemId BigInt? @map("item_id")
 item WarehouseItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
 externalItemId String? @map("external_item_id") @db.VarChar(255)
 quantity Decimal @db.Decimal(14,3)
 unitSnapshot String @map("unit_snapshot") @db.VarChar(50)
 itemArticleSnapshot String @map("item_article_snapshot") @db.VarChar(100)
 itemNameSnapshot String @map("item_name_snapshot") @db.VarChar(255)
 sourceType String @default("GOODS") @map("source_type") @db.VarChar(30)
 orderSnapshot Json? @map("order_snapshot") @db.JsonB
 reconciledToLineId BigInt? @map("reconciled_to_line_id")
 reconciledToLine WarehouseReceiptLine? @relation("ReceiptReconciliation", fields: [reconciledToLineId], references: [id], onDelete: Restrict)
 reconciledLines WarehouseReceiptLine[] @relation("ReceiptReconciliation")
 placements WarehouseReceiptPlacement[]
 @@unique([receiptId, externalLineId], map: "uq_warehouse_receipt_lines_external")
 @@index([itemId], map: "idx_warehouse_receipt_lines_item")
 @@index([reconciledToLineId], map: "idx_warehouse_receipt_lines_reconciliation")
 @@map("warehouse_receipt_lines")
}
model WarehouseReceiptPlacement {
 id BigInt @id @default(autoincrement())
 receiptLineId BigInt @map("receipt_line_id")
 receiptLine WarehouseReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)
 storageLocationId BigInt @map("storage_location_id")
 storageLocation WarehouseStorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
 quantity Decimal @db.Decimal(14,3)
 itemSnapshot Json @map("item_snapshot") @db.JsonB
 locationSnapshot Json @map("location_snapshot") @db.JsonB
 createdByUserId String @map("created_by_user_id")
 actor User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
 requestKey String @map("request_key") @db.Uuid
 requestHash String @map("request_hash") @db.VarChar(64)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 @@unique([createdByUserId, requestKey], map: "uq_warehouse_receipt_placements_request")
 @@index([receiptLineId], map: "idx_warehouse_receipt_placements_line")
 @@index([storageLocationId], map: "idx_warehouse_receipt_placements_location")
 @@map("warehouse_receipt_placements")
}
model WarehouseItemExternalLink {
 id BigInt @id @default(autoincrement())
 itemId BigInt @map("item_id")
 item WarehouseItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
 sourceSystem String @map("source_system") @db.VarChar(100)
 externalId String @map("external_id") @db.VarChar(255)
 sourceArticle String @map("source_article") @db.VarChar(100)
 sourceName String @map("source_name") @db.VarChar(255)
 confirmedBy String @map("confirmed_by")
 confirmedByUser User @relation(fields: [confirmedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 @@unique([sourceSystem, externalId], map: "uq_warehouse_item_external_links_identity")
 @@index([itemId], map: "idx_warehouse_item_external_links_item")
 @@map("warehouse_item_external_links")
}
model WarehouseExternalWarehouse {
 id BigInt @id @default(autoincrement())
 warehouseId BigInt @map("warehouse_id")
 warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
 sourceSystem String @map("source_system") @db.VarChar(100)
 externalId String @map("external_id") @db.VarChar(255)
 confirmedBy String @map("confirmed_by")
 confirmedByUser User @relation(fields: [confirmedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 @@unique([sourceSystem, externalId], map: "uq_warehouse_external_warehouses_identity")
 @@map("warehouse_external_warehouses")
}
model WarehouseIssueRequest {
 actorUserId String @map("actor_user_id")
 requestKey String @map("request_key") @db.Uuid
 requestHash String @map("request_hash") @db.VarChar(64)
 issueId BigInt @unique(map: "uq_warehouse_issue_requests_issue") @map("issue_id")
 response Json @db.JsonB
 actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
 issue WarehouseIssue @relation(fields: [issueId], references: [id], onDelete: Restrict, onUpdate: Cascade)
 @@id([actorUserId, requestKey])
 @@map("warehouse_issue_requests")
}

model WarehouseTransfer {
  id BigInt @id @default(autoincrement())
  itemId BigInt @map("item_id")
  item WarehouseItem @relation(fields:[itemId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  fromLocationId BigInt @map("from_location_id")
  fromLocation WarehouseStorageLocation @relation("WarehouseTransferFrom",fields:[fromLocationId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  toLocationId BigInt @map("to_location_id")
  toLocation WarehouseStorageLocation @relation("WarehouseTransferTo",fields:[toLocationId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  quantity Decimal @db.Decimal(14,3)
  comment String? @db.VarChar(4000)
  createdByUserId String @map("created_by_user_id")
  createdBy User @relation(fields:[createdByUserId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  requestKey String @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  snapshot Json @db.JsonB
  @@unique([createdByUserId,requestKey],map:"uq_warehouse_transfers_request")
  @@index([itemId,createdAt],map:"idx_warehouse_transfers_item")
  @@index([fromLocationId,createdAt],map:"idx_warehouse_transfers_from")
  @@index([toLocationId,createdAt],map:"idx_warehouse_transfers_to")
  @@index([createdAt,id],map:"idx_warehouse_transfers_created")
  @@map("warehouse_transfers")
}

model WarehouseStockAdjustmentNoop {
 actorUserId String @map("actor_user_id")
 requestKey String @map("request_key") @db.Uuid
 requestHash String @map("request_hash") @db.VarChar(64)
 quantity Decimal @db.Decimal(14, 3)
 actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
 @@id([actorUserId, requestKey])
 @@map("warehouse_stock_adjustment_noops")
}
