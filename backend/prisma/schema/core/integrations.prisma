model IntegrationSource {
  id String @id @db.Uuid
  code String @unique(map: "uq_integration_sources_code") @db.VarChar(100)
  name String @db.VarChar(200)
  systemType String @map("system_type") @db.VarChar(50)
  baseUrl String @map("base_url") @db.VarChar(2000)
  authorizationEncrypted String @map("authorization_encrypted") @db.Text
  actorUserId String @map("actor_user_id")
  actor User @relation(fields:[actorUserId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  actorLink IntegrationSourceActor?
  flows IntegrationFlow[]
  @@unique([id,actorUserId],map:"uq_integration_sources_id_actor")
  @@map("integration_sources")
}
model IntegrationFlow {
  sourceId String @map("source_id") @db.Uuid
  flowCode String @map("flow_code") @db.VarChar(100)
  source IntegrationSource @relation(fields:[sourceId],references:[id],onDelete:Restrict)
  isActive Boolean @default(true) @map("is_active")
  configVersion Int @map("config_version")
  config Json @db.JsonB
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastErrorAt DateTime? @map("last_error_at") @db.Timestamptz(6)
  lastErrorCode String? @map("last_error_code") @db.VarChar(100)
  events IntegrationEvent[]
  @@id([sourceId,flowCode])
  @@map("integration_flows")
}
model IntegrationEvent {
  id BigInt @id @default(autoincrement())
  sourceId String @map("source_id") @db.Uuid
  flowCode String @map("flow_code") @db.VarChar(100)
  flow IntegrationFlow @relation(fields:[sourceId,flowCode],references:[sourceId,flowCode],onDelete:Restrict,map:"integration_events_flow_fkey")
  eventId String @map("event_id") @db.Uuid
  objectId String @map("object_id") @db.VarChar(255)
  type String @db.VarChar(100)
  version String @db.VarChar(255)
  requestHash String @map("request_hash") @db.VarChar(64)
  status String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  retryAttempts Int @default(0) @map("retry_attempts")
  manualRetryCount Int @default(0) @map("manual_retry_count")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner String? @map("lease_owner") @db.VarChar(100)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  startedAt DateTime? @map("started_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  lastErrorCode String? @map("last_error_code") @db.VarChar(100)
  resultCode String? @map("result_code") @db.VarChar(100)
  resultSummary Json? @map("result_summary") @db.JsonB
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  journal IntegrationAttempt[]
  @@unique([sourceId,flowCode,eventId],map:"uq_integration_events_identity")
  @@index([status,nextAttemptAt,id],map:"idx_integration_events_pending")
  @@index([status,leaseUntil,id],map:"idx_integration_events_lease")
  @@map("integration_events")
}
model IntegrationAttempt {
  leaseToken String @id @map("lease_token") @db.Uuid
  eventId BigInt @map("event_id")
  event IntegrationEvent @relation(fields:[eventId],references:[id],onDelete:Restrict)
  startedAt DateTime @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  outcome String @default("PROCESSING") @db.VarChar(30)
  errorCode String? @map("error_code") @db.VarChar(100)
  @@index([eventId,startedAt],map:"idx_integration_attempts_event")
  @@map("integration_attempts")
}

model IntegrationSourceActor {
  sourceId String @id @map("source_id") @db.Uuid
  actorUserId String @map("actor_user_id")
  source IntegrationSource @relation(fields:[sourceId,actorUserId],references:[id,actorUserId],onDelete:Restrict,onUpdate:Cascade,map:"integration_source_actors_source_fkey")
  actor User @relation(fields:[actorUserId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  permissions SystemActorPermission[]
  @@unique([sourceId,actorUserId],map:"uq_integration_source_actors_pair")
  @@map("integration_source_actors")
}
