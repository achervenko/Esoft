model CustomerOrder {
  id String @id @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  source IntegrationSource @relation(fields:[sourceId],references:[id],onDelete:Restrict)
  externalId String? @map("external_id") @db.Uuid
  number String @db.VarChar(100)
  name String @db.VarChar(1000)
  documentDate String @map("document_date") @db.VarChar(19)
  status String @db.VarChar(100)
  posted Boolean
  deletionMark Boolean @map("deletion_mark")
  missingChecks Int @default(0) @map("missing_checks")
  checkedAt DateTime @map("checked_at") @db.Timestamptz(6)
  changedAt DateTime @map("changed_at") @db.Timestamptz(6)
  history CustomerOrderChange[]
  @@unique([sourceId,externalId],map:"uq_customer_orders_external")
  @@index([number,id],map:"idx_customer_orders_number")
  @@map("customer_orders")
}
model CustomerOrderChange {
  id BigInt @id @default(autoincrement())
  orderId String @map("order_id") @db.Uuid
  order CustomerOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  before Json? @db.JsonB
  after Json @db.JsonB
  observedAt DateTime @map("observed_at") @db.Timestamptz(6)
  @@index([orderId,id],map:"idx_customer_order_changes_order")
  @@map("customer_order_changes")
}
model OrderSyncRun {
  id String @id @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  source IntegrationSource @relation(fields:[sourceId],references:[id],onDelete:Restrict)
  startedAt DateTime @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime @map("finished_at") @db.Timestamptz(6)
  outcome String @db.VarChar(20)
  received Int?
  changed Int?
  errorCode String? @map("error_code") @db.VarChar(100)
  @@index([sourceId,startedAt,id],map:"idx_order_sync_runs_source")
  @@map("order_sync_runs")
}
