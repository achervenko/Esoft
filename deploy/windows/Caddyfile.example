{
    admin 127.0.0.1:2019
}

insolution-esoft.ru {
    # Certificate renewal is performed externally through DNS validation.
    tls C:/Esoft/certs/fullchain.pem C:/Esoft/certs/privkey.pem
    encode gzip

    @backend path /api /api/* /health
    @assets path /assets/*
    @html path / /index.html
    handle @backend {
        reverse_proxy 127.0.0.1:3000
    }

    handle {
        root * C:/Esoft/app/frontend/dist
        # Hashed assets can be cached; HTML must be revalidated after updates.
        header @assets Cache-Control "public, max-age=31536000, immutable"
        header @html Cache-Control "no-cache"
        file_server
    }
}
