# ============================================================
# Локальная конфигурация Esoft
#
# Создать локальную конфигурацию:
# Windows PowerShell:
# Copy-Item .env.example .env
#
# macOS/Linux:
# cp .env.example .env
#
# Подробное описание:
# ./docs/CONFIGURATION.md
# ============================================================


# ============================================================
# Режим приложения
# ============================================================

# Допустимые значения: development, test, production.
NODE_ENV=development


# ============================================================
# Backend
# ============================================================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
BACKEND_URL=http://127.0.0.1:3000


# ============================================================
# Frontend
# ============================================================

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Обычно должен соответствовать FRONTEND_HOST и FRONTEND_PORT.
FRONTEND_URL=http://127.0.0.1:5173

# Переменные с префиксом VITE_ доступны в коде браузера.
# Не помещайте секреты в переменные VITE_*.
# Публичный адрес backend, используемый кодом браузера.
# Обычно должен совпадать с BACKEND_URL.
VITE_API_URL=http://127.0.0.1:3000


# ============================================================
# PostgreSQL
# ============================================================

DATABASE_URL=postgresql://esoft:change_me@127.0.0.1:5432/esoft?schema=public

# Имя Windows-службы, используется только npm run doctor.
# Пример: postgresql-x64-17
POSTGRES_SERVICE_NAME=postgresql-x64-17


# ============================================================
# Авторизация
# ============================================================

# Замените на длинное случайное значение.
BETTER_AUTH_SECRET=change_me_to_a_long_random_secret

# Обычно должен совпадать с BACKEND_URL.
BETTER_AUTH_URL=http://127.0.0.1:3000


# ============================================================
# MinIO
# ============================================================

MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false

# Используется при ручном запуске локального MinIO, npm run dev или npm run doctor.
MINIO_ROOT_USER=esoft
MINIO_ROOT_PASSWORD=change_me

# Используется backend как S3-учётные данные.
MINIO_ACCESS_KEY=esoft
MINIO_SECRET_KEY=change_me

MINIO_BUCKET=esoft

# Windows-пути проще поддерживать с прямыми слэшами.
MINIO_EXECUTABLE=C:/MinIO/minio.exe
MINIO_DATA_DIR=C:/MinIO/data


# ============================================================
# Production backup
# ============================================================

# Корневой каталог production backup. Каждый запуск создаёт timestamp-папку внутри.
BACKUP_DIR=C:/EsoftBackups

# Необязательно. Если pg_dump не находится в PATH, укажите полный путь.
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe

# Необязательно. Если pg_restore не находится в PATH, укажите полный путь.
# PG_RESTORE_PATH=C:/Program Files/PostgreSQL/17/bin/pg_restore.exe
